# 复制到 .env 并按需填写
# Copy to .env and fill in

# ===== 数据库 / Database =====
# 本地开发用 SQLite（不用改）
# Local dev: SQLite (no change needed)
DATABASE_URL="file:./dev.db"

# 生产用 PostgreSQL（部署 Railway 时这个由 Railway 自动注入）
# Production: PostgreSQL (auto-injected by Railway)
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ===== Cloudinary（图片云存储） =====
# 没填这三个的话上传会自动落到 public/uploads/，方便本地测试
# If unset, uploads fall back to local public/uploads/ (great for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== 管理员后台密码 =====
# /admin 入口的密码（Phase 4 后台才会用到，先随便填）
ADMIN_PASSWORD="changeme-in-production"
# 管理员会话令牌的签名密钥(≥16 字符,随机生成:openssl rand -base64 32)。**生产必配**;不配则退回 scrypt(ADMIN_PASSWORD) 派生并打警告
ADMIN_SESSION_SECRET=

# ===== Sprint 7: 黑堡本地信息流 scraper =====
# GitHub Action 触发 scraper endpoint 时的鉴权 secret
# 生产环境用 `openssl rand -hex 32` 生成,GH repo secrets 和 Railway 两边值要一致
SCRAPER_SECRET=

# ===== LLM(用于 HTML 提取 + 中文摘要翻译) =====
# 默认走 DeepSeek(便宜 + 中文友好),也可换成其他 OpenAI-compatible provider
# 模型名以 https://api-docs.deepseek.com/quick_start/pricing/ 为准(2026-09-18 核对):现行只有 deepseek-flash 与
# deepseek-v4-pro;旧名 deepseek-v4-flash 仍接受(按 Flash 计费)。deepseek-chat 已不在定价页上,别再用。
# DeepSeek 的 thinking 模式默认开启;src/lib/llm.ts 对 DeepSeek 默认带 thinking:{type:'disabled'}(抽取 / 翻译不需要推理)。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-v4-pro
LLM_UTILITY_MODEL=deepseek-flash

# ===== Embedding + 语义搜索(Sprint 10)=====
# 发帖时异步算向量、回填脚本、10B 起的语义检索都走这里。key 留空:发布照常成功,embeddedAt 留空,配上 key 后跑
# `npm run backfill:embeddings`(本地)或 POST /api/admin/backfill-embeddings(Railway)补。
# 生产 pgvector 列是 vector(1536),换维度不同的模型必须同时改两份 schema。
LLM_EMBED_BASE_URL=https://api.openai.com/v1
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=text-embedding-3-small
# 语义搜索 / AI 助手总开关(10B / 10C 读)。false 或 embedding key 缺失 → 第 1、2 层整体隐藏,关键词搜索照常。默认关。
SEARCH_AI_ENABLED=false
# 语义候选的余弦相似度阈值(10B),低于它丢弃。默认 0.35;嫌结果太散调高,嫌太少调低
SEARCH_SEMANTIC_MIN_SIM=0.35
# AI 单日总费用上限(美元,10C)。超过后对话接口返回 503、第 2 层隐藏,第 1 层不受影响。默认 2;设 0 = 直接关掉对话
SEARCH_AI_DAILY_BUDGET_USD=2

# ===== Sprint 7 Phase 3B: Magic-link 邮箱登录 + OG 分享卡片 =====
# 站点公开 URL(Magic-link 邮件正文 + OG 图链接 + 微信群分享链接里用)
# 生产: https://your-domain;本地 dev 可空,代码自动 fallback http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Resend 邮件服务(magic-link 发送登录链接用)
# 注册 https://resend.com 拿免费 100 封/天的 API key
# 本地 dev 留空 → server 会把 magic-link URL 打到 console.log(调试用,够测)
# 生产留空 → /api/auth/magic-link/send 返 503(magic-link 不可用,
# 但识别码方案仍工作,不影响发布/管理流程)
RESEND_API_KEY=
# 发件人地址。Resend 提供 onboarding@resend.dev(免域名验证,默认值)
# 自有域名(blacksburg-secondhand.com 之类)需先在 Resend dashboard verify
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# ===== 维护摘要(Sprint 9D)=====
# GitHub Actions 每日调 /api/admin/digest 用的 bearer(≥16 字符,随机);同时配到 repo secrets DIGEST_SECRET
DIGEST_SECRET=
# 摘要邮件收件人(越过阈值才发)
DIGEST_EMAIL_TO=
